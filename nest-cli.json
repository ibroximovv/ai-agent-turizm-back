{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "builder": "swc",
    "typeCheck": true,
    "swc": {
      "sourceMaps": true,
      "jsc": {
        "parser": {
          "syntax": "typescript",
          "decorators": true
        },
        "target": "es2023"
      },
      "module": {
        "type": "es6"
      }
    }
  }
}
