# Application
NODE_ENV=development
PORT=3005

# PostgreSQL Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=turizm_db
# Auto-create/update tables from the entities. Keep true until migrations exist.
POSTGRES_SYNC=true
POSTGRES_LOGGING=false

# Storage
# Root directory for raw uploads and generated Markdown.
# Defaults to <project>/uploads; `raw/` and `ready/` are created inside it.
UPLOADS_DIR=
# Rejected with HTTP 413 above this size.
MAX_UPLOAD_MB=200

# Open WebUI Integration
OWUI_URL=http://localhost:8080
OWUI_API_KEY=
OWUI_KB_ID=
OWUI_TIMEOUT_MS=30000
