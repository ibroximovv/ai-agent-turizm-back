# =========================================================================
#  AI Agent Turizm — backend konfiguratsiyasi
#  Nusxa oling:  cp .env.example .env
# =========================================================================

# --- Application ---------------------------------------------------------
# Muhit nomi: development | staging | production. /api/ javobida ko'rinadi.
APP_ENV=development
# DJANGO_DEBUG=false bo'lganda MAJBURIY. Yaratish:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
# Vergul bilan ajratilgan hostlar. DEBUG yoqilganda standart qiymat — *.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,[::1]
# HTTPS orqasida adminka forma yuborishi uchun kerak (sxema bilan birga),
# masalan: https://turizm.example.uz
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3005,http://127.0.0.1:3005
# `manage.py runserver` uchun port.
PORT=3005
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# --- Xavfsizlik (faqat DJANGO_DEBUG=false bo'lganda kuchga kiradi) --------
# TLS'siz ichki deploy uchun ikkalasini false qiling, aks holda login ishlamaydi.
SESSION_COOKIE_SECURE=true
CSRF_COOKIE_SECURE=true
# nginx allaqachon http -> https yo'naltiradi, shuning uchun bu o'chiq.
SECURE_SSL_REDIRECT=false
# HSTS ixtiyoriy: 0 = o'chiq. HTTPS barqaror ishlagach 2592000 (30 kun) qiling.
# Diqqat: brauzer bu sarlavhani ko'rgach, shu muddat davomida oddiy HTTP'ni
# butunlay rad etadi — sertifikat muddati o'tib ketsa, saytga kirib bo'lmaydi.
SECURE_HSTS_SECONDS=0

# --- PostgreSQL ----------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=turizm_db
# Har bir SQL so'rovni logga chiqarish (sekinlashtiradi, faqat debug uchun).
POSTGRES_LOGGING=false
# Ulanishni necha soniya qayta ishlatish. 0 — har so'rovda yangi ulanish.
POSTGRES_CONN_MAX_AGE=60

# --- Auth ----------------------------------------------------------------
# false qilinsa API tokensiz ochiladi — faqat lokal sinov uchun.
API_REQUIRE_AUTH=true
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=14

# --- Storage -------------------------------------------------------------
# Xom fayllar va yaratilgan Markdown uchun ildiz papka (absolut yo'l).
# Ichida raw/ va ready/ avtomatik yaratiladi. Bo'sh qoldirilsa <loyiha>/uploads.
UPLOADS_DIR=
# Bundan katta fayl HTTP 413 bilan rad etiladi.
MAX_UPLOAD_MB=200

# --- Pipeline ------------------------------------------------------------
# Bir vaqtda nechta hujjat konvertatsiya qilinadi. Katta PDF'lar xotirada
# to'liq saqlanadi, shuning uchun bu sonni ehtiyotkorlik bilan oshiring.
PIPELINE_CONCURRENCY=2
# true — konvertatsiya fon oqimi o'rniga so'rov ichida bajariladi (debug/test).
PIPELINE_RUN_SYNC=false
# Server qayta ishga tushganda yarim yo'lda qolgan materiallarni qayta navbatga qo'yish.
PIPELINE_RESUME_ON_START=true

# --- Open WebUI integration ----------------------------------------------
# Knowledge Base identifikatori bu yerda sozlanmaydi: har bir modul o'zining
# KB'siga ega va u `modules.owui_kb_id` ustunida saqlanadi.
OWUI_URL=http://localhost:8080
OWUI_API_KEY=
# Millisekundda. Oddiy (metadata) so'rovlar uchun.
OWUI_TIMEOUT_MS=30000
# Fayl yuklash va KB'ga qo'shish embedding bilan sinxron bajariladi — katta
# hujjat bir necha daqiqa oladi. Open WebUI oldidagi nginx proxy_read_timeout
# ham shundan kam bo'lmasin.
OWUI_INDEX_TIMEOUT_MS=600000
# Yangi yaratiladigan agentlar (modul agentlari va umumiy agent):
OWUI_AGENT_BASE_MODEL=turizm_router.avto
OWUI_AGENT_TOOL_IDS=ofis_saqlash_tool
# Sozlamalari (vositalar, capabilities, parametrlar) yangi agentlarga
# ko'chiriladigan preset. Prompt esa apps/owui/prompts/ shablonidan olinadi.
OWUI_AGENT_TEMPLATE_MODEL_ID=modul-1---gid-yordamchisi
# Barcha modullar KB'larini birlashtiruvchi agent.
OWUI_MASTER_MODEL_ID=turizm-umumiy-agent
OWUI_MASTER_MODEL_NAME=Turizm — umumiy gid yordamchisi
# true — agentlar va KB'lar barcha Open WebUI foydalanuvchilariga ochiq (o'qish).
OWUI_SHARE_WITH_USERS=true

# --- CORS ----------------------------------------------------------------
# true bo'lganda quyidagi ro'yxat e'tiborga olinmaydi. Productionda false
# qiling — shunda faqat CORS_ALLOWED_ORIGINS dagi manzillar ruxsat oladi.
CORS_ALLOW_ALL_ORIGINS=true
CORS_ALLOWED_ORIGINS=http://localhost:3005,http://127.0.0.1:3005

# --- Locale --------------------------------------------------------------
LANGUAGE_CODE=uz
TIME_ZONE=Asia/Tashkent
